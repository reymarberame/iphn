APP_NAME=BHN
# Production deployments must use APP_ENV=production and APP_DEBUG=false.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — Supabase Postgres (use the Session Pooler on port 5432 for
# migrations and transactions). See docs/IMPLEMENTATION.md for details.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
# DB_SEARCH_PATH=public

# One-time MySQL source used by `php artisan db:copy-to-postgres`.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=bhn_db
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true and SESSION_ENCRYPT=true behind HTTPS in production.
SESSION_SECURE_COOKIE=false
# Sanctum bearer tokens expire after this many minutes (8 hours).
SANCTUM_EXPIRATION_MINUTES=480

BROADCAST_CONNECTION=supabase
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bhn.test"
MAIL_FROM_NAME="${APP_NAME}"

# Demo accounts created by DatabaseSeeder. Change before any shared deployment.
BHN_DEMO_PASSWORD=Password@123
# Show the demo-account shortcuts on /login. Only honored when APP_ENV=local.
BHN_SHOW_DEMO_ACCOUNTS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Supabase Storage (S3 protocol) — create the bucket in Storage, then create
# S3 access keys under Project Settings → Storage → S3 access keys.
# Set REFERRAL_DOCUMENTS_DISK=supabase in production.
# ---------------------------------------------------------------------------
REFERRAL_DOCUMENTS_DISK=local
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=bhn-storage
SUPABASE_S3_USE_PATH_STYLE=true

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Supabase Realtime (chat). The server broadcasts with the secret key; the
# browser receives only the publishable key and an HMAC-derived user topic.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=<service-role key, server only>

# Vercel Schedule calls GET /cron/expire-reservations with this bearer token.
CRON_SECRET=
